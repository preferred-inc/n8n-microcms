# ローカル検証用の microCMS 接続情報
# このファイルをコピーして .env を作る（.env は .gitignore 済み）
#
#   cp .env.example .env
#
# 値は microCMS 管理画面 → サービス設定 → API キー から取得する。
# 絶対にリポジトリへコミットしないこと。

# https://xxxx.microcms.io の xxxx の部分だけを入れる
MICROCMS_SERVICE_DOMAIN=

# Content API / Management API のキー
MICROCMS_API_KEY=

# 動作確認に使うエンドポイント名（例: blogs）
MICROCMS_TEST_ENDPOINT=
